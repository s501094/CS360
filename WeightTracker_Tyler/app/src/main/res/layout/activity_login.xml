<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Custom fluid wave background view -->
    <com.tyler.weighttracker.WaveBackgroundView
        android:id="@+id/loginRootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Foreground UI Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="70dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weight Tracker"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#CBA6F7"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Authenticate or register profile"
            android:textSize="13sp"
            android:textColor="#A6E3A1"
            android:letterSpacing="0.03"
            android:layout_marginBottom="44dp" />

        <EditText
            android:id="@+id/usernameEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Username or Email"
            android:textColor="#CDD6F4"
            android:textColorHint="#585B70"
            android:background="#181825"
            android:paddingHorizontal="18dp"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/passwordEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Password"
            android:textColor="#CDD6F4"
            android:textColorHint="#585B70"
            android:background="#181825"
            android:paddingHorizontal="18dp"
            android:inputType="textPassword"
            android:maxLines="1"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Login"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#11111B"
            android:backgroundTint="#CBA6F7"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Create Account"
            android:textSize="15sp"
            android:textColor="#CBA6F7"
            android:backgroundTint="#181825" />

    </LinearLayout>
</RelativeLayout>