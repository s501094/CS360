<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_row"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:layout_marginBottom="10dp">

    <!-- Accent rail, tinted by trend direction -->
    <View
        android:id="@+id/rowAccent"
        android:layout_width="3dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_pill"
        android:layout_marginEnd="14dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/rowWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/ctp_text"
                tools:text="210.0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_lbs"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:textColor="@color/ctp_overlay0"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/ctp_overlay2"
            android:layout_marginTop="3dp"
            tools:text="Aug 16, 2026" />
    </LinearLayout>

    <TextView
        android:id="@+id/rowDelta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:drawablePadding="2dp"
        tools:text="1.2" />
</LinearLayout>
